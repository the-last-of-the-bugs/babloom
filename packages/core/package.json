{
  "name": "@tlob/babloom-core",
  "version": "0.1.1",
  "description": "Framework-agnostic TypeScript rich-text editor core for BaBloom",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "editor",
    "rich-text",
    "wysiwyg",
    "typescript",
    "babloom"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-last-of-the-bugs/babloom.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/the-last-of-the-bugs/babloom/issues"
  },
  "homepage": "https://github.com/the-last-of-the-bugs/babloom"
